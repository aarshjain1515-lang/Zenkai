# Zenkai Configuration Template
# Copy to .env and configure secrets locally. Do not commit .env to version control.

# Diagnostic Agent LLM Mode: 'mock' (default, offline deterministic) or 'live'
LLM_MODE=mock

# Live Model Provider Configuration (Required only when LLM_MODE=live)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=5.0
LLM_MAX_TOKENS=500

# SQLite Database Path
ZENKAI_DB_PATH=./data/zenkai.db
