# Local-only Grafana admin login. Change this before first startup.
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-password

# Neon: pooled runtime URL; direct URL for migrations. Both must require TLS.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Generate local secrets with: uv run python scripts/init_local.py
OPERATOR_PASSWORD=
SESSION_SECRET=
LAB_TOKEN=
AUTO_APPROVE_SAFE=true
